# Copy to .env and fill in real values. .env is git-ignored.
# Every variable here is read by backend/app/core/config.py (Settings).

# One of: local | test | ci
APP_ENV=local

# PostgreSQL (Docker Compose publishes on 5433; host Postgres keeps 5432)
POSTGRES_USER=finsight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finsight
DATABASE_URL=postgresql+psycopg://finsight:change-me@localhost:5433/finsight
# Optional: absolute path for Postgres data (default: a Docker named volume)
# POSTGRES_DATA_DIR=/absolute/path/to/finsight-ai/data/postgres

# Redis and Qdrant (Docker Compose)
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Ollama on the host (model names chosen in ADR-003)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Logging: JSON lines on stderr (false = plain text), and the minimum level
LOG_JSON=true
LOG_LEVEL=INFO

# Readiness check timeout per dependency, in seconds
READY_TIMEOUT_SECONDS=2

# Login sessions: lifetime in hours, and browser origins allowed to send POST/PUT/PATCH/DELETE
SESSION_TTL_HOURS=12
ALLOWED_ORIGINS=["http://localhost:5173"]

# Background jobs: uploaded files wait here until the worker has processed them.
# UPLOAD_DIR=/absolute/path/to/uploads
# A running job older than this (seconds) is treated as abandoned and re-delivered.
# JOB_STALE_AFTER_SECONDS=1800

# Rate limits per bucket, "<requests>/<seconds>" (JSON).
# RATE_LIMITS={"login_ip":"30/60","login_email":"10/300","upload":"20/60","scoring":"10/60","answers":"30/60"}
