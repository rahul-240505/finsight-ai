# Copy to .env and fill in real values. .env is git-ignored.
# Every variable here is read by backend/app/core/config.py (Settings).

# One of: local | test | ci
APP_ENV=local

# PostgreSQL (Docker Compose publishes on 5433; host Postgres keeps 5432)
POSTGRES_USER=finsight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finsight
DATABASE_URL=postgresql+psycopg://finsight:change-me@localhost:5433/finsight

# Redis and Qdrant (Docker Compose)
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Ollama on the host (model names chosen in ADR-003)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Readiness check timeout per dependency, in seconds
READY_TIMEOUT_SECONDS=2

# Login sessions: lifetime in hours, and browser origins allowed to send POST/PUT/PATCH/DELETE
SESSION_TTL_HOURS=12
ALLOWED_ORIGINS=["http://localhost:5173"]
